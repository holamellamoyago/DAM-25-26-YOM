	<dataset name="DatasetCursos" uuid="86ebde9d-a4bd-4870-a33f-73a082ecc691">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adapter Examen"/>
		<query language="SQL"><![CDATA[SELECT COUNT(C.nombre) AS TOTAL_CURSOS
FROM CURSOS C ]]></query>
		<field name="TOTAL_CURSOS" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL_CURSOS"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL_CURSOS"/>
		</field>
		<group name="TOTAL_CURSOS">
			<expression><![CDATA[$F{TOTAL_CURSOS}]]></expression>
		</group>
	</dataset>
	<dataset name="DatasetAlumnos" uuid="9e075eff-6ed1-4264-9ed6-5cd869e2b4c4">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adapter Examen"/>
		<query language="SQL"><![CDATA[SELECT
COUNT(*) AS TOTAL_ALUMNOS,
AVG(nota_ev1) AS MEDIA_AV1,
AVG(nota_ev2) AS MEDIA_AV2,
AVG(nota_ev3) AS MEDIA_AV3,
AVG(faltas) AS MEDIA_FALTAS,
MAX(faltas) AS MAX_FALTAS
FROM ALUMNOS A
INNER JOIN CURSO_ALUMNO CA ON A.dni = CA.dni_alumno
]]></query>
		<field name="TOTAL_ALUMNOS" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL_ALUMNOS"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL_ALUMNOS"/>
		</field>
		<field name="MEDIA_AV1" class="java.lang.Float">
			<property name="com.jaspersoft.studio.field.name" value="MEDIA_AV1"/>
			<property name="com.jaspersoft.studio.field.label" value="MEDIA_AV1"/>
		</field>
		<field name="MEDIA_AV2" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="MEDIA_AV2"/>
			<property name="com.jaspersoft.studio.field.label" value="MEDIA_AV2"/>
		</field>
		<field name="MEDIA_AV3" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="MEDIA_AV3"/>
			<property name="com.jaspersoft.studio.field.label" value="MEDIA_AV3"/>
		</field>
		<field name="MEDIA_FALTAS" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="MEDIA_FALTAS"/>
			<property name="com.jaspersoft.studio.field.label" value="MEDIA_FALTAS"/>
		</field>
		<field name="MAX_FALTAS" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="MAX_FALTAS"/>
			<property name="com.jaspersoft.studio.field.label" value="MAX_FALTAS"/>
		</field>
		<group name="TOTAL_ALUMNOS">
			<expression><![CDATA[$F{TOTAL_ALUMNOS}]]></expression>
		</group>
	</dataset>
	<dataset name="DatasetAlumnos2" uuid="361a6692-4389-4ced-a6cb-77fc4520700f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adapter Examen"/>
		<query language="SQL"><![CDATA[SELECT COUNT(dni)
FROM ALUMNOS]]></query>
		<field name="COUNT(dni)" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="COUNT(dni)"/>
			<property name="com.jaspersoft.studio.field.label" value="COUNT(dni)"/>
		</field>
		<group name="COUNT(dni)">
			<expression><![CDATA[$F{COUNT(dni)}]]></expression>
		</group>
	</dataset>
	<query language="SQL"><![CDATA[SELECT 
    a.dni AS alumno_dni,
    a.nombre AS alumno_nombre,
    a.apellidos AS alumno_apellidos,
    c.id AS curso_id,
    c.nombre AS curso_nombre,
    c.num_total_sesiones AS curso_num_total_sesiones,
    ca.nota_ev1 AS nota_ev1,
    ca.nota_ev2 AS nota_ev2,
    ca.nota_ev3 AS nota_ev3,
    ca.faltas AS faltas
FROM alumnos a
JOIN curso_alumno ca ON a.dni = ca.dni_alumno
JOIN cursos c ON ca.id_curso = c.id
ORDER BY c.nombre, a.apellidos, a.nombre]]></query>
