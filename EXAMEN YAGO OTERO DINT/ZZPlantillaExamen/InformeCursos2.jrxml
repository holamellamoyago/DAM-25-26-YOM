<jasperReport name="InformeCursos" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="147bdd8b-f9ff-4ab9-84dd-122b666a1815">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adapter Examen"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="470"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="523"/>
	<query language="sql"><![CDATA[SELECT examen_final_dint_centro.alumnos.dni,
	examen_final_dint_centro.alumnos.nombre,
	examen_final_dint_centro.alumnos.apellidos,
	examen_final_dint_centro.curso_alumno.nota_ev1,
	examen_final_dint_centro.curso_alumno.nota_ev2,
	examen_final_dint_centro.curso_alumno.nota_ev3,
	examen_final_dint_centro.curso_alumno.faltas,
	examen_final_dint_centro.cursos.id,
	examen_final_dint_centro.cursos.nombre,
	examen_final_dint_centro.cursos.num_total_sesiones,
		examen_final_dint_centro.curso_alumno.nota_ev1 + 	examen_final_dint_centro.curso_alumno.nota_ev2 
		+ 	examen_final_dint_centro.curso_alumno.nota_ev3 / 3 AS NFINAL
FROM examen_final_dint_centro.curso_alumno
	INNER JOIN examen_final_dint_centro.alumnos ON 
	 examen_final_dint_centro.curso_alumno.dni_alumno = examen_final_dint_centro.alumnos.dni 
	INNER JOIN examen_final_dint_centro.cursos ON 
	 examen_final_dint_centro.curso_alumno.id_curso = examen_final_dint_centro.cursos.id ]]></query>
