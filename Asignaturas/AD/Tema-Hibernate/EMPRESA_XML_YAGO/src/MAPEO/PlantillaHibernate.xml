        </id>

        <!-- Clave cogida de otro clase -->
        <id name="nss" type="string">
            <column name="NSS" length="15" />
            <generator class="foreign">
                <param name="property">empregado</param> <!-- Esto es un objeto que esta dentro de la
                case -->
            </generator>
        </id>

        <!-- Tipos de generator de claves primarias -->
        <generator class="increment" /> <!-- Hace el Max(codigo ) +1 -->
        <generator class="identity" /> <!-- Deja el trabajo al gestor de bd-->
        <generator class="assigned" />


        <!-- Tipos de datos 
            java.lang.Integer  
            date       
            java.lang.Character
            timestamp
        -->


        <!-- Creación de componentes -->
        <!-- Direccion -->
        <component name="direccion" class="POJOS.Direccion">
            <property name="rua" type="string">
                <column length="30" name="Rua" />
            </property>
            <property name="numeroCalle" type="java.lang.Integer">
                <column name="Numero_Calle" />
