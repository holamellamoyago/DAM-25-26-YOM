<hibernate-mapping>
    <class catalog="EMPRESAHB26" name="POJOS.Empregado" schema="dbo" table="EMPREGADO">
        <id name="nss" type="string">
            <column length="15" name="NSS" />
            <generator class="assigned" />
        </id>

        <property name="nome" type="string">
            <column length="25" name="Nome" not-null="true" />
        </property>
        <property name="apelido1" type="string">
            <column length="25" name="Apelido1" not-null="true" />
        </property>
        <property name="apelido2" type="string">
            <column length="25" name="Apelido2" />
        </property>
        <property name="dataNacemento" type="timestamp">
            <column length="23" name="DataNacemento" />
        </property>
        <property name="sexo" type="java.lang.Character">
            <column length="1" name="Sexo" />
        </property>

        <!-- Direccion -->
        <component name="direccion" class="POJOS.Direccion">
            <property name="rua" type="string">
                <column length="30" name="Rua" />
            </property>
            <property name="numeroCalle" type="java.lang.Integer">
                <column name="Numero_Calle" />
            </property>
            <property name="piso" type="string">
                <column length="4" name="Piso" />
            </property>
            <property name="cp" type="string">
                <column length="5" name="CP" />
            </property>
            <property name="localidade" type="string">
                <column length="25" name="Localidade" />
            </property>
            <property name="provincia" type="string">
                <column length="15" name="Provincia" />
            </property>
        </component>

        <!-- TELEFONOS -->
        <map name="telefonos" table="TELEFONO" lazy="false">
            <key>
                <column name="NSS" length="15" not-null="true" />
            </key>
            <map-key column="Telefono" type="string" />
            <element column="Informacion" type="string" />
        </map>


        <!-- Mapear el departamento al qu e pertenece el empleado -->
        <many-to-one class="POJOS.Departamento" fetch="select" name="departamento" lazy="false">
            <column name="NumDepartamentoPertenece" />
        </many-to-one>

        <!-- Mapear la relación 1:1 a vehículo -->
        <one-to-one name="vehiculo" class="POJOS.Vehiculo" fetch="select" lazy="false" cascade="all" />


        <!-- Relación n:n con Habilidad -->
        <set name="habilidades" table="HABILIDAD_EMPREGADO" lazy="false" fetch="select">
            <key column="NSS"/>
            <many-to-many class="POJOS.Habilidad" column="codigoHabilidad" />
        </set>


        <!-- Mapear la relación n:n con proxectos (horas) -->
        <set name="proxectos" inverse="true" cascade="all-delete-orphan" lazy="false">
            <key column="NSSEmpregado" />
            <one-to-many class="POJOS.EmpregadoProxecto" />
        </set>

        <!-- Mapeo de los familiares -->
        <list name="familiares" table="FAMILIAR" lazy="false">
            <key>
                <column name="NSS_Empregado"/>
            </key>
            <list-index base="1" column="Numero"/>
            <composite-element class="POJOS.Familiar">
                <property name="nss" type="string">
                    <column name="NSS"></column>
                </property>
            </composite-element>
        </list>


    </class>

</hibernate-mapping>