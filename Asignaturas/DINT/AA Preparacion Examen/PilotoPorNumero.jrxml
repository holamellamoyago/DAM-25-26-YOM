	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Conector F1 History"/>
	<parameter name="NumPiloto" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT driver_id,
	first_name,
	permanent_number
FROM f1_history.drivers
WHERE  f1_history.drivers.permanent_number  =  $P{NumPiloto} ]]></query>
