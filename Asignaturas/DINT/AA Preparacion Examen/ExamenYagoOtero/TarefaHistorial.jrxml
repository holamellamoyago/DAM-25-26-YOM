		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<query language="SQL"><![CDATA[SELECT gimnasio.usuario.`DNI`,
	gimnasio.historial.`Accion`,
	gimnasio.historial.`Codigo`,
	gimnasio.usuario.`Nombre`,
	gimnasio.usuario.`Apellidos`,
	gimnasio.usuario.`Edad`
FROM gimnasio.usuario
	INNER JOIN gimnasio.historial ON 
	 gimnasio.historial.`DNI` = gimnasio.usuario.`DNI`]]></query>
