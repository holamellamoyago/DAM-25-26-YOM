<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Tarefa1" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bd523938-e4cf-4c38-be65-77b180513fc3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DatabaseInterfaces"/>
	<parameter name="IdPedido" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT interfaces.clientes.nombre,
	interfaces.clientes.direccion,
	interfaces.clientes.pais,
	interfaces.clientes.descuento,
	interfaces.clientes.id_cliente,
	interfaces.pedidos.vendedor,
	interfaces.pedidos.fecha_pedido,
	interfaces.pedidos.fecha_entrega,
	interfaces.pedidos.fecha_envio,
	interfaces.pedidos.forma_envio,
	interfaces.productos.id_producto,
	interfaces.productos.id_pedido,
	interfaces.productos.nombre,
	interfaces.productos.cantidad,
	interfaces.productos.precio,
	interfaces.pedidos.cargo,
	(interfaces.productos.precio * interfaces.productos.cantidad) *
    (1 - interfaces.clientes.descuento / 100.0) AS precio_con_descuento,
   ((interfaces.productos.precio * interfaces.productos.cantidad) * (1 - interfaces.clientes.descuento / 100.0)) + 
    interfaces.pedidos.cargo  AS precio_con_cargo
FROM interfaces.productos
	INNER JOIN interfaces.pedidos ON 
	 interfaces.productos.id_pedido = interfaces.pedidos.id_pedido 
	INNER JOIN interfaces.clientes ON 
	 interfaces.pedidos.id_cliente = interfaces.clientes.id_cliente
WHERE 	interfaces.productos.id_pedido =  $P{IdPedido} ]]></query>
