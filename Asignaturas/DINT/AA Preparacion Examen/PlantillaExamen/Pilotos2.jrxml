	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Conector F1 History"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value="ZjFfaGlzdG9yeS5kcml2ZXJzIEFTICwxNzEsODAsMTZkNDMwN2EtNjQ3NS00ZTEzLTkyNzgtMTlm&#xa;YzYzMDI4YWExOw=="/>
	<dataset name="Carreras Ganadas" uuid="403fbd05-0aeb-4edb-a6b9-a565ab43acc1">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Conector F1 History"/>
		<query language="SQL"><![CDATA[SELECT 
    d.first_name, 
    COUNT(*) AS victorias
FROM f1_history.results r
INNER JOIN f1_history.drivers d ON r.driver_id = d.driver_id
WHERE r.final_position = 1
GROUP BY d.first_name
ORDER BY victorias DESC]]></query>
		<field name="first_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="first_name"/>
			<property name="com.jaspersoft.studio.field.label" value="first_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="drivers"/>
		</field>
		<field name="victorias" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="victorias"/>
			<property name="com.jaspersoft.studio.field.label" value="victorias"/>
		</field>
		<group name="first_name">
			<expression><![CDATA[$F{first_name}]]></expression>
		</group>
		<group name="victorias">
			<expression><![CDATA[$F{victorias}]]></expression>
		</group>
	</dataset>
	<query language="sql"><![CDATA[SELECT driver_id,
	first_name,
