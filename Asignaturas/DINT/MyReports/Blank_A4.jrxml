	<query language="sql"><![CDATA[SELECT "ADDRESS"."FIRSTNAME",
	"DOCUMENT"."ADDRESSID",
	"DOCUMENT"."TOTAL",
	"DOCUMENT"."ID",
	"ADDRESS"."LASTNAME",
	"ADDRESS"."STREET",
	"ADDRESS"."CITY"
FROM "ADDRESS"
	INNER JOIN "DOCUMENT" ON 
	 "DOCUMENT"."ADDRESSID" = "ADDRESS"."ID"]]></query>
