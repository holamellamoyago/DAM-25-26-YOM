	<query language="SQL"><![CDATA[SELECT "DOCUMENT"."ID",
	"DOCUMENT"."TOTAL",
	"ADDRESS"."ID",
	"ADDRESS"."FIRSTNAME",
	"ADDRESS"."LASTNAME",
	"ADDRESS"."STREET",
	"ADDRESS"."CITY"
FROM "ADDRESS"
	INNER JOIN "DOCUMENT" ON 
	 "DOCUMENT"."ADDRESSID" = "ADDRESS"."ID"]]></query>
