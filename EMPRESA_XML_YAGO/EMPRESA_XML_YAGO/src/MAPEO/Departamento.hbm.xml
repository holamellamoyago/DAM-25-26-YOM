<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="POJOS.Departamento" table="DEPARTAMENTO" schema="dbo" catalog="EMPRESAHB26">
        <id name="numDepartamento" type="int">
            <column name="NumDepartamento" />
            <generator class="increment" />
        </id>
        <property name="nomeDepartamento" type="string">
            <column name="NomeDepartamento" length="25" not-null="true" unique="true" />
        </property>
        <!-- funciones -->
        <set name="funciones" table="FUNCION" lazy="false">
            <key column="NumDepartamento"/>
            <element column="Funcion" type="string"/>
        </set>
        <!-- Proxectos Hacer en casa 
        <set name="proxectos" table="PROXECTO" inverse="true" lazy="false" fetch="select">
            <column name="NumDepartControla" not-null="true"/>
        </set>
        -->
    </class>
</hibernate-mapping>